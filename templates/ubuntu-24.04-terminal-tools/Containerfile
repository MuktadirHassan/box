ARG BASE_IMAGE
FROM ${BASE_IMAGE}

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      file \
      git \
      iproute2 \
      iputils-ping \
      jq \
      neovim \
      podman \
      procps \
      ripgrep \
      sudo \
      tmux \
      wl-clipboard

RUN case "$(dpkg --print-architecture)" in \
      amd64) fastfetch_arch=amd64 ;; \
      arm64) fastfetch_arch=aarch64 ;; \
      *) exit 1 ;; \
    esac \
 && curl --fail --show-error --silent --location --retry 3 \
      "https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-${fastfetch_arch}.deb" \
      --output /tmp/fastfetch.deb \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends /tmp/fastfetch.deb \
 && rm /tmp/fastfetch.deb

ARG BOX_SHELL=sh
RUN case "$BOX_SHELL" in \
      sh|bash) ;; \
      fish|zsh) apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends "$BOX_SHELL" ;; \
      *) exit 1 ;; \
    esac

ARG BOX_USER
ARG BOX_UID
ARG BOX_GID
RUN test -n "$BOX_USER" \
 && test "$BOX_UID" -gt 0 \
 && test "$BOX_GID" -gt 0 \
 && case "$BOX_SHELL" in \
      sh) shell_path=/bin/sh ;; \
      bash) shell_path=/bin/bash ;; \
      fish) shell_path=/usr/bin/fish ;; \
      zsh) shell_path=/usr/bin/zsh ;; \
      *) exit 1 ;; \
    esac \
 && existing_group="$(getent group "$BOX_GID" | cut -d: -f1)" \
 && if [ -n "$existing_group" ] && [ "$existing_group" != "$BOX_USER" ]; then \
      ! getent group "$BOX_USER" >/dev/null && groupmod --new-name "$BOX_USER" "$existing_group"; \
    elif [ -z "$existing_group" ]; then \
      ! getent group "$BOX_USER" >/dev/null && groupadd --gid "$BOX_GID" "$BOX_USER"; \
    fi \
 && existing_user="$(getent passwd "$BOX_UID" | cut -d: -f1)" \
 && if [ -n "$existing_user" ] && [ "$existing_user" != "$BOX_USER" ]; then \
      ! getent passwd "$BOX_USER" >/dev/null && usermod --login "$BOX_USER" "$existing_user"; \
    elif [ -z "$existing_user" ]; then \
      ! getent passwd "$BOX_USER" >/dev/null && useradd --no-create-home --uid "$BOX_UID" --gid "$BOX_GID" "$BOX_USER"; \
    fi \
 && usermod --home "/home/$BOX_USER" --shell "$shell_path" --gid "$BOX_GID" "$BOX_USER" \
 && install --directory --owner "$BOX_UID" --group "$BOX_GID" --mode 0755 "/home/$BOX_USER" \
 && printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$BOX_USER" > "/etc/sudoers.d/box-$BOX_USER" \
 && chmod 0440 "/etc/sudoers.d/box-$BOX_USER"

RUN curl --fail --show-error --silent --location --retry 3 \
      https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh \
      --output /tmp/install-homebrew \
 && curl --fail --show-error --silent --location --retry 3 \
      https://mise.run \
      --output /tmp/install-mise \
 && runuser --user "$BOX_USER" -- env HOME="/home/$BOX_USER" NONINTERACTIVE=1 /bin/bash /tmp/install-homebrew \
 && runuser --user "$BOX_USER" -- env HOME="/home/$BOX_USER" /bin/sh /tmp/install-mise \
 && rm /tmp/install-homebrew /tmp/install-mise

ARG BOX_PROMPT=none
RUN case "$BOX_PROMPT" in \
      none) ;; \
      starship) \
        curl --fail --show-error --silent --location --retry 3 \
          https://starship.rs/install.sh \
          --output /tmp/install-starship \
        && /bin/sh /tmp/install-starship --yes --bin-dir /usr/local/bin \
        && rm /tmp/install-starship \
        ;; \
      *) exit 1 ;; \
    esac

COPY dotfiles/ /usr/local/share/box-template/dotfiles/
COPY --chmod=0755 initialize-home /usr/local/bin/box-initialize-home

ARG BOX_TEMPLATE_REVISION=0
RUN test "$BOX_TEMPLATE_REVISION" -ge 0

ENTRYPOINT ["/usr/local/bin/box-initialize-home"]
