#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
# shellcheck source=lib/common.sh
source "$ROOT/containers/lib/common.sh"

dry_run=false
recreate=false

usage() {
    cat <<'EOF'
Usage: ./containers/ops/create [--recreate] [--dry-run]

Build and create the rootless ops container with a dedicated container home.

Options:
  --recreate  Remove an existing container before creating it; keeps its home
  --dry-run   Print state-changing commands without running them
  -h, --help  Show this help
EOF
}

while (($#)); do
    case "$1" in
        --recreate) recreate=true ;;
        --dry-run) dry_run=true ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

name=ops
home="$CONTAINER_HOME_BASE/$name"

build_image "$name"
if [[ "$recreate" == true ]]; then
    remove_container "$name"
fi
prepare_home "$home"
create_container "$name" "$home"

printf 'ops is ready: ./containers/ops/enter\n'
