#!/usr/bin/env bash
set -Eeuo pipefail

if ! command -v podman >/dev/null 2>&1; then
    printf '%s\n' 'Required command is not installed: podman' >&2
    exit 1
fi

if ! podman container exists dotfiles-dev; then
    printf '%s\n' 'dev container does not exist. Create it with ./containers/dev/create' >&2
    exit 1
fi

if [[ "$(podman container inspect --format '{{.State.Running}}' dotfiles-dev)" == true ]]; then
    exec podman exec --interactive --tty dotfiles-dev fish --login
fi

exec podman start --attach --interactive dotfiles-dev
