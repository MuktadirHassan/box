#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
# shellcheck source=lib/common.sh
source "$ROOT/containers/lib/common.sh"

dry_run=false
recreate=false

usage() {
    cat <<'EOF'
Usage: ./containers/dev/create [--recreate] [--dry-run]

Build and create the rootless dev container. It receives a dedicated container
home, the dotfiles checkout (read-only), DeveloperCache, /ssd2/projects,
~/.claude, and the active host Wayland socket.

Options:
  --recreate  Remove an existing container before creating it; keeps its home
  --dry-run   Print state-changing commands without running them
  -h, --help  Show this help
EOF
}

while (($#)); do
    case "$1" in
        --recreate) recreate=true ;;
        --dry-run) dry_run=true ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

name=dev
home="$CONTAINER_HOME_BASE/$name"
cache="$HOME/DeveloperCache"
projects="/ssd2/projects"
claude_home="$HOME/.claude"

if [[ -z "${XDG_RUNTIME_DIR:-}" || -z "${WAYLAND_DISPLAY:-}" ]]; then
    printf '%s\n' 'An active Wayland session is required to create the dev container.' >&2
    exit 1
fi

wayland_socket="$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
if [[ ! -S "$wayland_socket" ]]; then
    printf 'Wayland socket is unavailable: %s\n' "$wayland_socket" >&2
    exit 1
fi

wayland_args=(
    --env "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
    --env XDG_RUNTIME_DIR=/tmp
    --mount "type=bind,src=$wayland_socket,dst=/tmp/$WAYLAND_DISPLAY,rw"
)

build_image "$name"
if [[ "$recreate" == true ]]; then
    remove_container "$name"
fi
prepare_home "$home"
run mkdir -p -- "$cache"
bootstrap_container "$name" "$home" \
    "${wayland_args[@]}" \
    --mount "type=bind,src=$cache,dst=/home/$CONTAINER_USER/DeveloperCache,rw" \
    --mount "type=bind,src=$projects,dst=/home/$CONTAINER_USER/projects,rw" \
    --mount "type=bind,src=$claude_home,dst=/home/$CONTAINER_USER/.claude,rw"
create_container "$name" "$home" \
    "${wayland_args[@]}" \
    --mount "type=bind,src=$cache,dst=/home/$CONTAINER_USER/DeveloperCache,rw" \
    --mount "type=bind,src=$projects,dst=/home/$CONTAINER_USER/projects,rw" \
    --mount "type=bind,src=$claude_home,dst=/home/$CONTAINER_USER/.claude,rw"

printf 'dev is ready: ./containers/dev/enter\n'
